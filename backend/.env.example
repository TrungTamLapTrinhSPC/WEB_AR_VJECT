PORT=3001
FRONTEND_URL=http://localhost:5173
BACKUP_DIR=./backups
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vjectar
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=certs/global-bundle.pem

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=pa3:

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

CACHE_TTL_LIST=60
CACHE_TTL_DETAIL=300
CACHE_TTL_DASHBOARD=120
CACHE_TTL_SETTINGS=600

# Email OTP (đăng ký). Dev: để trống SMTP → in code ra console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PA3 Admin <noreply@example.com>"

# AWS S3 upload
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# IFC upload: convert trong Node (web-ifc), logic tham chiếu backend/converter_core.py

# Mật khẩu mạnh (đăng ký + admin tạo user)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
